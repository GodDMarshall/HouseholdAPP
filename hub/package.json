    "fastify": "^5.2.1",
    "mqtt": "^5.10.3",
    "multicast-dns": "^7.2.5",
    "onvif": "^0.7.1",
    "tsx": "^4.19.2",
    "tuyapi": "^7.7.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
