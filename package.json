{
  "name": "house-control",
  "version": "0.1.0",
  "private": true,
  "description": "House Control \u2014 a private hub and touch-first app for the whole house: cameras, gate, lights, with WiFi/SIM failover.",
  "workspaces": [
    "shared",
    "hub",
    "app"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:hub": "npm run dev -w hub",
    "dev:app": "npm run dev -w app",
    "build": "npm run build -w app",
    "start": "npm run start -w hub",
    "test": "npm run test -w hub",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "reset-pin": "node --no-warnings scripts/reset-pin.mjs",
    "test:e2e": "node e2e/walk.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
